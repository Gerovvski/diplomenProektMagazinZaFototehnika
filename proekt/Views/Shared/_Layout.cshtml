<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - proekt</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background: #f5f7fa;
        }

        .navbar {
            background: white !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        .nav-link {
            font-weight: 500;
            transition: 0.2s;
        }

            .nav-link:hover {
                color: #2563eb !important;
            }

        .category-dropdown {
            border-radius: 10px;
        }

        .category-link {
            padding: 8px 12px;
            display: block;
            color: #111827;
            text-decoration: none;
        }

            .category-link:hover {
                background: #f3f4f6;
                border-radius: 8px;
            }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light mb-3">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    Магазин
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Продукти</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                Категории
                            </a>

                            <div class="dropdown-menu category-dropdown p-2">

                                <a class="category-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="1">📷 Камери</a>
                                <a class="category-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="2">📊 Стативи</a>
                                <a class="category-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="3">🔍 Обективи</a>
                                <a class="category-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="4">💡 Осветление</a>
                                <a class="category-link" asp-controller="Products" asp-action="Index" asp-route-categoryId="5">🎒 Аксесоари</a>

                            </div>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                    Управление на категории
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- otdqsno -->
                    <ul class="navbar-nav ms-auto d-flex align-items-center gap-3">

                        <!-- kontakti -->
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#contactModal">
                                📞 Контакти
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                🛒 Количка
                            </a>
                        </li>

                        <li class="nav-item">
                            <partial name="_LoginPartial" />
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3">
        &copy; 2026 - Магазин
    </footer>

    <div class="modal fade" id="contactModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">📞 Контакти</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p><strong>Телефон:</strong> +359 888 123 456</p>
                    <p><strong>Email:</strong> shop@email.com</p>
                    <p><strong>Адрес:</strong> България</p>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>