@model proekt.Data.Order

@{
    ViewData["Title"] = "Order Details";
}

<style>
    .order-card {
        max-width: 900px;
        margin: 30px auto;
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        border-top: 5px solid #0d6efd;
    }

    .order-header {
        text-align: center;
        font-weight: 700;
        margin-bottom: 25px;
        color: #0d6efd;
    }

    .order-info {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .info-box {
        flex: 1;
        min-width: 200px;
        padding: 12px;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 4px solid #0d6efd;
    }

    .info-label {
        font-weight: 600;
        color: #555;
        font-size: 14px;
    }

    .info-value {
        font-size: 16px;
        font-weight: 500;
        color: #222;
    }

    .product-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #ddd;
        margin-right: 10px;
    }

    .product-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table thead {
        background: #0d6efd;
        color: white;
    }

    .table tbody tr:hover {
        background: #f1f7ff;
        transition: 0.2s;
    }

    .total-box {
        text-align: right;
        font-size: 18px;
        font-weight: bold;
        margin-top: 15px;
        color: #198754;
    }

    .btn-area {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }
</style>

<div class="order-card">

    <h2 class="order-header">Order Summary</h2>

    <div class="order-info">

        <div class="info-box">
            <div class="info-label">Order Date</div>
            <div class="info-value">@Model.OrderDate</div>
        </div>

        <div class="info-box">
            <div class="info-label">Total Price</div>
            <div class="info-value">@Model.TotalPrice лв.</div>
        </div>

    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">

            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Details)
                {
                    <tr>
                        <td>
                            <div class="product-cell">
                                <img src="@item.Product?.ImageUrl"
                                     class="product-img" />

                                <span>@item.Product?.Name</span>
                            </div>
                        </td>

                        <td>@item.Quantity</td>

                        <td>@item.Price лв.</td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="total-box">
        Total: @Model.TotalPrice лв.
    </div>

    <div class="btn-area">
        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>

</div>