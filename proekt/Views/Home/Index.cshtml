@model IEnumerable<proekt.Data.Product>

@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #eef2f7, #dbeafe);
    }

    .hero {
        background: linear-gradient(135deg, #2563eb, #1e3a8a);
        color: white;
        padding: 70px 20px;
        text-align: center;
        border-radius: 18px;
        margin: 30px auto;
        max-width: 1200px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

        .hero h1 {
            font-size: 36px;
            font-weight: 800;
        }

        .hero p {
            opacity: 0.9;
        }

    .section-title {
        text-align: center;
        margin: 40px 0 20px;
        font-size: 28px;
        font-weight: 800;
        color: #111827;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        max-width: 1200px;
        margin: auto;
        padding: 20px;
    }

    .product-card {
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(6px);
        border-radius: 16px;
        padding: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.12);
        }

    .product-img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 12px;
    }

    .product-title {
        font-weight: 700;
        margin-top: 10px;
        font-size: 16px;
    }

    .product-price {
        color: #16a34a;
        font-weight: 800;
        margin-top: 5px;
    }

    .btn-custom {
        width: 100%;
        margin-top: 8px;
        border-radius: 10px;
    }

    .features {
        margin-top: 60px;
        text-align: center;
    }

    .feature-box {
        display: inline-block;
        background: white;
        padding: 20px;
        margin: 10px;
        border-radius: 14px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.08);
        min-width: 160px;
        transition: 0.3s;
    }

        .feature-box:hover {
            transform: translateY(-5px);
        }
</style>

<!-- HERO -->
<div class="hero">
    <h1>📸 Фото техника на топ цени</h1>
    <p>Най-добрите продукти за твоите снимки</p>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-light btn-lg mt-3">
        Виж всички продукти
    </a>
</div>

<!-- SECTION -->
<div class="section-title">
    🔥 Най-често купувани
</div>

<div class="product-grid">

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model.Take(6))
        {
            <div class="product-card">

                <img src="@item.ImageUrl" class="product-img" />

                <div class="product-title">@item.Name</div>

                <div class="product-price">@item.Price лв.</div>

                <a asp-controller="Cart"
                   asp-action="AddToCart"
                   asp-route-id="@item.Id"
                   class="btn btn-primary btn-custom">
                    Добави в количка
                </a>

                <a asp-controller="Products"
                   asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-outline-secondary btn-custom">
                    Виж повече
                </a>

            </div>
        }
    }
    else
    {
        <p style="text-align:center;">Няма налични продукти</p>
    }

</div>

<!-- FEATURES -->
<div class="features">

    <h3 style="margin-bottom:20px;">Защо да избереш нас?</h3>

    <div class="feature-box">🚚<br />Бърза доставка</div>
    <div class="feature-box">💳<br />Сигурно плащане</div>
    <div class="feature-box">⭐<br />Високо качество</div>

</div>