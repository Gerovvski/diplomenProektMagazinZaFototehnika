@model IEnumerable<proekt.Data.Product>

@{
    ViewData["Title"] = "Products";
}

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
    }

    h1 {
        text-align: center;
        margin: 20px 0;
        font-weight: 700;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        max-width: 1200px;
        margin: auto;
        padding: 20px;
    }

    .product-card {
        background: rgba(255,255,255,0.95);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
        cursor: pointer;
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }

    .product-body {
        padding: 15px;
    }

    .product-title {
        font-size: 18px;
        font-weight: 700;
    }

    .product-price {
        color: #16a34a;
        font-weight: 700;
        margin-top: 5px;
    }

    .product-details {
        display: none;
        margin-top: 10px;
        font-size: 14px;
        color: #374151;
    }

    .product-card.active .product-details {
        display: block;
    }

    .btn-group {
        margin-top: 10px;
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

   

    }
</style>

<h2 style="text-align:center; margin:20px 0;">
    Категория: <span style="color:#2563eb;">
        @ViewBag.CategoryName
    </span>
</h2>
@if (User.IsInRole("Admin"))
{
    <div style="text-align:center; margin-bottom:20px;">
        <a asp-action="Create"
           class="btn btn-success btn-lg">
            + Add Product
        </a>
    </div>
}
<div class="product-grid">

    @foreach (var item in Model)
    {
        <div class="product-card" onclick="toggleCard(this)">

            <img src="@item.ImageUrl" class="product-img" />

            <div class="product-body">

                <div class="product-title">@item.Name</div>

                <div class="product-price">@item.Price лв.</div>

                <div class="product-details">

                    <hr />

                    <p><b>Description:</b> @item.Description</p>
                    <p><b>Model:</b> @item.Model</p>
                    <p><b>Category:</b> @item.Categories?.Name</p>

                    <div class="btn-group">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        @if (!User.IsInRole("Admin"))
                        {
                            <a asp-controller="Cart"
                               asp-action="AddToCart"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                Add
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  onsubmit="return confirm('Delete this product?');">

                                <button type="submit" class="btn btn-danger btn-sm">
                                    Delete
                                </button>

                            </form>
                        }

                    </div>

                </div>

            </div>

        </div>
    }

</div>

<script>
    function toggleCard(card) {
        card.classList.toggle("active");
    }
</script>