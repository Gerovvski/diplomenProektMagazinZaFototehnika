@model proekt.Data.Product

@{
    ViewData["Title"] = "Създаване на продукт";
}

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
        font-family: Arial, sans-serif;
    }

    .form-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 0 15px;
    }

    .form-card {
        background: rgba(255,255,255,0.95);
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.10);
    }

    .title {
        text-align: center;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #111827;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: 600;
        margin-bottom: 5px;
        display: block;
        color: #374151;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        outline: none;
        transition: 0.2s;
    }

        input:focus, select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 5px rgba(59,130,246,0.3);
        }

    .btn-submit {
        width: 100%;
        padding: 12px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-submit:hover {
            background: #1d4ed8;
        }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 15px;
        color: #374151;
        text-decoration: none;
    }

        .back-link:hover {
            color: #111827;
        }

    .text-danger {
        font-size: 13px;
    }
</style>

<div class="form-container">

    <div class="form-card">

        <div class="title">Създаване на продукт</div>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label>Каталожен номер</label>
                <input asp-for="CatalogNumber" />
                <span asp-validation-for="CatalogNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Име</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Описание</label>
                <input asp-for="Description" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Модел</label>
                <input asp-for="Model" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Цена</label>
                <input asp-for="Price" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>URL на снимка</label>
                <input asp-for="ImageUrl" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Категория</label>
                <select asp-for="CategoryId" asp-items="ViewBag.CategoryId"></select>
            </div>

            <button type="submit" class="btn-submit">
                Създай продукт
            </button>

        </form>

        <a asp-action="Index" class="back-link">
            ← Назад към продуктите
        </a>

    </div>

</div>