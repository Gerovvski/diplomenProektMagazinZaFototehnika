@model proekt.Data.Product

@{
    ViewData["Title"] = "Delete Product";
}

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
        font-family: Arial, sans-serif;
    }

    .delete-container {
        max-width: 700px;
        margin: 50px auto;
        padding: 0 15px;
    }

    .delete-card {
        background: rgba(255,255,255,0.95);
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.10);
        border-top: 5px solid #dc2626;
    }

    .title {
        text-align: center;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #111827;
    }

    .warning {
        text-align: center;
        color: #dc2626;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    .info-box {
        background: #f9fafb;
        padding: 12px;
        border-radius: 10px;
        border: 1px solid #e5e7eb;
    }

    .label {
        font-size: 13px;
        color: #6b7280;
    }

    .value {
        font-weight: 600;
        color: #111827;
    }

    .btn-area {
        display: flex;
        justify-content: space-between;
        margin-top: 20px;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        padding: 10px 18px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-back {
        background: #374151;
        color: white;
        padding: 10px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-back:hover {
            background: #111827;
        }

    

    .btn-area {
        flex-direction: column;
        gap: 10px;
    }

    }
</style>

<div class="delete-container">

    <div class="delete-card">

        <div class="title">Delete Product</div>

        <div class="warning">
            ⚠ Are you sure you want to delete this product?
        </div>

        <div class="info-grid">

            <div class="info-box">
                <div class="label">Name</div>
                <div class="value">@Model.Name</div>
            </div>

            <div class="info-box">
                <div class="label">Price</div>
                <div class="value">@Model.Price лв.</div>
            </div>

            <div class="info-box">
                <div class="label">Model</div>
                <div class="value">@Model.Model</div>
            </div>

            <div class="info-box">
                <div class="label">Catalog Number</div>
                <div class="value">@Model.CatalogNumber</div>
            </div>

        </div>

        <form asp-action="Delete">

            <input type="hidden" asp-for="Id" />

            <div class="btn-area">

                <a asp-action="Index" class="btn-back">
                    Cancel
                </a>

                <button type="submit" class="btn-delete">
                    Delete
                </button>

            </div>

        </form>

    </div>

</div>