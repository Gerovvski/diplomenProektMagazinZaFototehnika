@model proekt.Data.Category

@{
    ViewData["Title"] = "Изтриване на категория";
}

@if (User.IsInRole("Admin"))
{
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
            font-family: Arial, sans-serif;
        }

        .delete-container {
            max-width: 650px;
            margin: 70px auto;
            padding: 0 15px;
        }

        .card-box {
            background: rgba(255,255,255,0.95);
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.10);
            border-top: 5px solid #dc2626;
        }

        .title {
            text-align: center;
            font-size: 26px;
            font-weight: 700;
            color: #dc2626;
            margin-bottom: 10px;
        }

        .warning {
            text-align: center;
            color: #374151;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .info-box {
            background: #f9fafb;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 10px;
            border-left: 4px solid #dc2626;
        }

        .label {
            font-size: 13px;
            color: #6b7280;
        }

        .value {
            font-weight: 600;
            color: #111827;
        }

        .btn-area {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            gap: 10px;
        }

        .btn-delete {
            flex: 1;
            padding: 10px;
            background: #dc2626;
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

            .btn-delete:hover {
                background: #b91c1c;
            }

        .btn-back {
            flex: 1;
            padding: 10px;
            text-align: center;
            background: #374151;
            color: white;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
        }

            .btn-back:hover {
                background: #111827;
            }

      
            .btn-area {
                flex-direction: column;
            }
        
    </style>

    <div class="delete-container">

        <div class="card-box">

            <div class="title">🗑 Изтриване</div>

            <div class="warning">
                Сигурен ли си, че искаш да изтриеш тази категория?
            </div>

            <div class="info-box">
                <div class="label">Име</div>
                <div class="value">@Model.Name</div>
            </div>

            <div class="info-box">
                <div class="label">Описание</div>
                <div class="value">@Model.Description</div>
            </div>

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <div class="btn-area">

                    <a asp-action="Index" class="btn-back">
                        Отказ
                    </a>

                    <button type="submit" class="btn-delete">
                        Изтрий
                    </button>

                </div>

            </form>

        </div>

    </div>
}
