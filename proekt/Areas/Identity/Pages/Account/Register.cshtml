@page
@model RegisterModel

@{
    ViewData["Title"] = "Регистрация";
}

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
        font-family: Arial, sans-serif;
    }

   
    .register-container {
        width: 100%;
        max-width: 520px;
        margin: 120px auto 40px auto; 
        padding: 20px;
    }

    .register-card {
        background: rgba(255,255,255,0.95);
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #111827;
    }

    .subtitle {
        text-align: center;
        color: #6b7280;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 12px;
    }

    input {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        outline: none;
        transition: 0.2s;
    }

        input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 6px rgba(37,99,235,0.3);
        }

    .btn-register {
        width: 100%;
        padding: 12px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
        margin-top: 10px;
    }

        .btn-register:hover {
            background: #1d4ed8;
        }

    .external {
        margin-top: 20px;
        text-align: center;
    }

        .external button {
            margin: 5px;
        }

    .text-danger {
        font-size: 13px;
    }

    @@media (max-width: 600px) {
        .register-container {
            margin-top: 100px;
        }

        .register-card {
            padding: 20px;
        }

        .title {
            font-size: 24px;
        }
    }
</style>

<div class="register-container">

    <div class="register-card">

        <div class="title">📝 Регистрация</div>
        <div class="subtitle">Създай нов акаунт</div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input asp-for="Input.UserName" placeholder="Потребителско име" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.Email" placeholder="Email" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.FirstName" placeholder="Име" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.LastName" placeholder="Фамилия" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.PhoneNumber" placeholder="Телефон" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.Password" type="password" placeholder="Парола" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.ConfirmPassword" type="password" placeholder="Потвърди парола" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-register">
                Регистрация
            </button>

        </form>

        <div class="external">

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <form asp-page="./ExternalLogin" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit"
                                class="btn btn-outline-primary"
                                name="provider"
                                value="@provider.Name">
                            Вход с @provider.DisplayName
                        </button>
                    }
                </form>
            }

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}