@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
        font-family: Arial, sans-serif;
    }

    /* ВАЖНО: центриране без да чупим navbar */
    .login-container {
        width: 100%;
        max-width: 420px;
        margin: 120px auto 40px auto; /* място за navbar отгоре */
        padding: 20px;
    }

    .login-card {
        background: rgba(255,255,255,0.95);
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #111827;
    }

    .subtitle {
        text-align: center;
        color: #6b7280;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    input {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        outline: none;
        transition: 0.2s;
    }

        input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 6px rgba(37,99,235,0.3);
        }

    .btn-login {
        width: 100%;
        padding: 12px;
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-login:hover {
            background: #1d4ed8;
        }

    .links {
        text-align: center;
        margin-top: 15px;
    }

        .links a {
            display: block;
            color: #2563eb;
            text-decoration: none;
            margin-top: 5px;
            font-size: 14px;
        }

            .links a:hover {
                text-decoration: underline;
            }

    .checkbox {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        font-size: 14px;
    }

    .external {
        margin-top: 20px;
        text-align: center;
    }

        .external button {
            margin: 5px;
        }

    .text-danger {
        font-size: 13px;
    }

    @@media (max-width: 480px) {
        .login-container {
            margin-top: 100px;
        }

        .login-card {
            padding: 20px;
        }

        .title {
            font-size: 24px;
        }
    }
</style>

<div class="login-container">

    <div class="login-card">

        <div class="title">🔐 Вход</div>
        <div class="subtitle">Добре дошъл обратно</div>

        <form id="account" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <input asp-for="Input.UserName" placeholder="Потребителско име" />
                <span asp-validation-for="Input.UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="Input.Password" type="password" placeholder="Парола" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="checkbox">
                <input asp-for="Input.RememberMe" />
                <label>Запомни ме</label>
            </div>

            <button type="submit" class="btn-login">
                Вход
            </button>

            <div class="links">
                <a asp-page="./ForgotPassword">Забравена парола?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    Регистрация
                </a>
                <a asp-page="./ResendEmailConfirmation">Потвърждение на имейл</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}